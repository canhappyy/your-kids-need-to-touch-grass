FROM public.ecr.aws/lambda/python:3.12

# Copy requirements generated by uv/SST
COPY requirements.txt /tmp/requirements.txt

# Mount uv binary to install dependencies into Lambda task root
RUN --mount=from=ghcr.io/astral-sh/uv,source=/uv,target=/bin/uv \
    uv pip install \
      --python /var/lang/bin/python3.12 \
      --target ${LAMBDA_TASK_ROOT} \
      --index https://download.pytorch.org/whl/cpu \
      --index-strategy unsafe-best-match \
      --requirements /tmp/requirements.txt

# Copy source files into Lambda task root
COPY . ${LAMBDA_TASK_ROOT}/

# Handle unpacked package directory structure if present
RUN if [ -d "${LAMBDA_TASK_ROOT}/playgo_ai_recommendation" ]; then \
      cp -r ${LAMBDA_TASK_ROOT}/playgo_ai_recommendation/* ${LAMBDA_TASK_ROOT}/; \
    fi

# Download and bake ONNX models into the container image
RUN PYTHONPATH=${LAMBDA_TASK_ROOT} /var/lang/bin/python3.12 \
      ${LAMBDA_TASK_ROOT}/download_models.py

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false

CMD ["handler.handler"]

